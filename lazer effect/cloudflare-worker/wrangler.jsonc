{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zenvq-laser-edge-api",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "routes": [
    {
      "pattern": "laser-api.zenvq.com",
      "custom_domain": true
    }
  ]
}
