# Cloudflare Worker Live Endpoint & Auth (for local CLI scripts/dispatch.js)
WORKER_URL=https://zenvq-social-dispatcher.YOUR-SUBDOMAIN.workers.dev
DISPATCHER_API_KEY=replace-with-strong-random-secret

# 1. Telegram Bot API (100% Free via @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 2. LinkedIn Official API
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=

# 3. Meta Facebook Page API v21.0
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=

# 4. Meta Instagram Business API v21.0 (requires public image mediaUrl)
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=

# 5. Twitter / X API v2 (OAuth 1.0a User Context - recommended for Free Tier)
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
# Or OAuth 2.0 User Context PKCE Bearer Token:
TWITTER_OAUTH2_TOKEN=
